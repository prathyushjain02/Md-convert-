# Every value here is optional — the app boots with sensible defaults.

# Largest request body accepted, in megabytes, counting every file in it.
MAX_UPLOAD_MB=50

# Files allowed per conversion request.
MAX_FILES=2

# Restrict accepted uploads. Comma-separated; omit to use the built-in list.
# ALLOWED_EXTENSIONS=.pdf,.docx,.pptx,.xlsx

# Accept any extension and let MarkItDown sniff the format from the contents.
ALLOW_ANY_EXTENSION=false

# Load third-party MarkItDown plugins installed in the environment.
MARKITDOWN_ENABLE_PLUGINS=false

# Size cap for the "Download all (.zip)" endpoint, in megabytes.
MAX_BUNDLE_MB=25

LOG_LEVEL=INFO

# gunicorn sizing (read by the Dockerfile / Procfile, not by the app).
WEB_CONCURRENCY=1
WEB_THREADS=2
WEB_TIMEOUT=300
